# Обов'язково: ключ Gemini (безкоштовного тіру достатньо).
# Отримати: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Опційно: порт HTTP-сервісу. Дефолт 7860 — саме його очікує Hugging Face
# Spaces від Docker-контейнера. Локально можна ставити будь-який.
# PORT=7860
# Резервні Gemini-ключі (з ключі2.txt) — пробуються в останню чергу при мертвому/вичерпаному основному.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
